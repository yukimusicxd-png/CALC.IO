{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CALC.IO",
  "version": "0.1.0",
  "identifier": "com.calc.io.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CALC.IO - STEM Workstation",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yukimusicxd-png/CALC.IO/releases/latest/download/latest.json"
      ]
    }
  }
}